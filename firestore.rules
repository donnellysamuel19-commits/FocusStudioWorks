rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // For assignmentGoals collection
    match /assignmentGoals/{assignmentId} {
      // A user can create a document if the document's userId matches their own.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // A user can read, update, or delete a document if the document's userId matches their own.
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // For studySessions collection
    match /studySessions/{sessionId} {
       // A user can create a document if the document's userId matches their own.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
       // A user can read, update, or delete a document if the document's userId matches their own.
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

     // For aiOutputs collection
    match /aiOutputs/{outputId} {
      // A user can create a document if the document's userId matches their own.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
